# prisma
/generated/
# Prisma 7 `prisma-client` generator output — regenerated by
# `prisma generate` in the Railway build step (and locally via
# `bun run db:push` / `bun run dev` after schema changes).
# Imports route through @/lib/generated/prisma/client.
lib/generated/prisma/
tests/visual/.auth/
tests/e2e/.auth/
test-results/

# v0-parity: prod snapshots are regenerated per-run, never committed
docs/v0-reference/_prod-current/

# superpowers worktrees (isolated feature work)
.worktrees/
.claude/

# Oracle diagnostics — generated by scripts/oracles/index.ts
docs/superpowers/diagnostics/oracle-runs/

# graphify knowledge-graph output (generated, multi-MB)
graphify-out/


# gstack/browse skill local state
.gstack/

# Tesseract OCR model (downloaded at runtime to tmpdir)
*.traineddata
scratch-e2e/
