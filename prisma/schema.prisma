model VendorNameMapping {
  id               String   @id @default(cuid())
  // #1 (Vick 2026-05-31): mappings are per-facility — a confirmed
  // "Howmedica → Stryker" rule for one facility must not change another
  // facility's vendor resolution. The import resolver consults
  // confirmed rows WHERE facilityId = current facility.
  facilityId       String
  cogVendorName    String
  mappedVendorId   String?
  mappedVendorName String?
  confidenceScore  Decimal? @db.Decimal(5, 2)
  isConfirmed      Boolean  @default(false)
  createdAt        DateTime @default(now())

  facility Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  vendor   Vendor?  @relation(fields: [mappedVendorId], references: [id])

  // One rule per (facility, cogVendorName) so the resolver lookup is
  // deterministic and remap upserts are idempotent.
  @@unique([facilityId, cogVendorName])
  @@index([cogVendorName])
  @@map("vendor_name_mapping")
}

/// Vendor "also known as" — the spellings a vendor's own name appears under in
/// facility-side COG / PO / invoice / contract files.
///
/// Charles 2026-07-27: the vendor workspace is named "Stryker", but facility
/// files carry "STRYKER SALES CORP", "Howmedica Osteonics" (Stryker's legal
/// manufacturing entity), "Stryker Flex Financial", "MAKO Surgical Corp"...
/// Ingestion resolved names through an 11-company hardcoded literal plus a 0.7
/// Levenshtein fallback; every spelling above MISSED and silently minted a new
/// global Vendor row, splitting the vendor's spend into unrelated silos.
///
/// Distinct from VendorNameMapping, which is a per-FACILITY override a facility
/// admin sets on their own COG page. This table is the VENDOR's own global
/// declaration of its identities, managed from vendor settings.
model VendorAlias {
  id       String @id @default(cuid())
  vendorId String
  /// As typed, preserved for display.
  alias    String
  /// `vendorNameKey(alias)` — the exact lookup key. See lib/vendors/normalize.ts.
  normalizedAlias String
  /// vendor | admin | seed — who asserted this alias.
  source   String @default("vendor")
  createdAt DateTime @default(now())

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  /// GLOBAL uniqueness is the over-merge guard: an alias resolves to exactly one
  /// vendor, so two companies can never both claim "Howmedica Osteonics" and
  /// quietly cross-attribute each other's spend.
  @@unique([normalizedAlias])
  @@index([vendorId])
  @@map("vendor_alias")
}

