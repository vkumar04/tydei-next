// ─── COG Data ─────────────────────────────────────────────────────

model COGRecord {
  id                   String   @id @default(cuid())
  facilityId           String
  vendorId             String?
  vendorName           String?
  inventoryNumber      String
  inventoryDescription String
  vendorItemNo         String?
  manufacturerNo       String?
  poNumber             String?
  unitCost             Decimal  @db.Decimal(12, 2)
  extendedPrice        Decimal? @db.Decimal(14, 2)
  quantity             Int      @default(1)
  transactionDate      DateTime @db.Date
  category             String?
  notes                String?
  createdBy            String?
  matchStatus          COGMatchStatus @default(pending)
  contractId           String?
  contractPrice        Decimal? @db.Decimal(12, 2)
  isOnContract         Boolean  @default(false)
  savingsAmount        Decimal? @db.Decimal(14, 2)
  variancePercent      Decimal? @db.Decimal(6, 2)
  fileImportId         String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  facility   Facility    @relation(fields: [facilityId], references: [id])
  vendor     Vendor?     @relation(fields: [vendorId], references: [id])
  fileImport FileImport? @relation(fields: [fileImportId], references: [id])

  @@index([facilityId])
  @@index([vendorId])
  @@index([transactionDate])
  @@index([vendorItemNo])
  @@index([matchStatus])
  @@index([facilityId, matchStatus])
  @@index([facilityId, transactionDate])
  @@index([contractId])
  // 2026-06-18 perf audit: per-contract windowed groupBys (contracts-list
  // trailing-12mo cascade, vendor-performance) range on (contractId, date).
  @@index([contractId, transactionDate])
  @@index([facilityId, isOnContract])
  @@index([fileImportId])
  @@map("cog_record")
}

// Vendor-owned COG (Settings/Users feature, 1-way mode). Mirrors
// COGRecord but is owned by a VENDOR, not a facility — `facilityId` is
// OPTIONAL here (a 1-way vendor enters its own purchasing data not tied
// to any facility). NEVER merged into facility COGRecord reads; keeps the
// "COG is always facility-scoped" invariant on COGRecord intact.
model VendorCogRecord {
  id                   String   @id @default(cuid())
  vendorId             String
  // Hard-isolation axis: null = vendor-wide, set = division-scoped.
  vendorDivisionId     String?
  // Optional facility context (a vendor may tag a row to a facility).
  facilityId           String?
  vendorName           String?
  inventoryNumber      String
  inventoryDescription String
  vendorItemNo         String?
  manufacturerNo       String?
  poNumber             String?
  unitCost             Decimal  @db.Decimal(12, 2)
  extendedPrice        Decimal? @db.Decimal(14, 2)
  quantity             Int      @default(1)
  transactionDate      DateTime @db.Date
  category             String?
  notes                String?
  matchStatus          COGMatchStatus @default(pending)
  contractId           String?
  contractPrice        Decimal? @db.Decimal(12, 2)
  isOnContract         Boolean  @default(false)
  savingsAmount        Decimal? @db.Decimal(14, 2)
  variancePercent      Decimal? @db.Decimal(6, 2)
  // Loose import-batch tag (no FK — FileImport requires a facility).
  fileImportId         String?
  createdBy            String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  vendor         Vendor          @relation(fields: [vendorId], references: [id])
  vendorDivision VendorDivision? @relation(fields: [vendorDivisionId], references: [id])

  @@index([vendorId])
  @@index([vendorDivisionId])
  @@index([transactionDate])
  @@index([vendorItemNo])
  @@index([contractId])
  @@index([vendorId, transactionDate])
  @@map("vendor_cog_record")
}

model PricingFile {
  id                 String    @id @default(cuid())
  vendorId           String
  facilityId         String
  vendorItemNo       String
  manufacturerNo     String?
  productDescription String
  listPrice          Decimal?  @db.Decimal(12, 2)
  contractPrice      Decimal?  @db.Decimal(12, 2)
  // Charles iMessage 2026-04-20 N17: "Carve out is something that
