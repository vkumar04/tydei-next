// ─── Rebate Optimizer AI Smart Recommendations ─────────────────────

// ─── Contract Extraction Cache (2026-04-26) ─────────────────────
//
// SHA256(file bytes) → cached AI extraction result. Re-uploads of
// the same PDF skip the 20-30s Claude round-trip + credit cost.
// Scoped per-user so two users can't see each other's extracted
// data even on identical PDFs (defensive — extracted JSON has
// vendor/contract identifiers a competitor shouldn't see).
model ContractExtractionCache {
  id         String   @id @default(cuid())
  /** SHA-256 hex digest of the uploaded file bytes. */
  fileHash   String
  /** User the cache row was generated for (scoping boundary). */
  userId     String
  /** Original filename — informational, used when serving back. */
  filename   String
  /** Full extracted payload (matches /api/ai/extract-contract response.extracted shape). */
  extracted  Json
  /** Confidence score from the extractor at the time of write. */
  confidence Float?
  /** S3 key the original file was archived to. Surfaced so the
   *  cache hit returns the same payload shape as a fresh extract. */
  s3Key      String?
  createdAt  DateTime @default(now())
  expiresAt  DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, fileHash])
  @@index([expiresAt])
  @@map("contract_extraction_cache")
}

model RebateInsightCache {
  id         String   @id @default(cuid())
  facilityId String
  inputHash  String
  response   Json
  model      String
  costCents  Int?
  createdAt  DateTime @default(now())
  expiresAt  DateTime

  facility Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  @@index([facilityId, expiresAt])
  @@index([facilityId, inputHash])
  @@map("rebate_insight_cache")
}

model RebateInsightFlag {
  id         String   @id @default(cuid())
  facilityId String
  insightId  String
  title      String
  summary    String
  snapshot   Json
  flaggedBy  String
  createdAt  DateTime @default(now())

  facility Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [flaggedBy], references: [id])

  @@index([facilityId, createdAt])
  @@map("rebate_insight_flag")
}

// ─── Renewal Brief AI Cache (Tier 4) ────────────────────────────────
//
// Per-contract 1-hour cache for generateRenewalBrief. Briefs change less
// frequently than Tier 1 rebate insights (contract-level history, not
// daily spend), so a longer TTL is cheaper without hurting freshness.

model RenewalBriefCache {
  id         String   @id @default(cuid())
  contractId String
  inputHash  String
  response   Json
  model      String
  costCents  Int?
  createdAt  DateTime @default(now())
  expiresAt  DateTime

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([contractId, expiresAt])
  @@index([contractId, inputHash])
  @@map("renewal_brief_cache")
}

// ─── Upload header telemetry (uploader improvements 2, 2026-06-13) ──
//
// Fire-and-forget log of upload header rows whose columns did NOT all
// auto-resolve (or where the user manually remapped/abandoned), written
// by the shared <PricingFileDropzone>. Lets us mine real-world header
// vocabularies and grow the canonical alias lists in
// lib/utils/parse-pricing-file.ts instead of waiting for bug reports.
// Fully-clean auto imports are NOT logged (noise).

model UploadHeaderEvent {
  id              String   @id @default(cuid())
  surface         String
  fileName        String?
  headers         Json
  autoMapping     Json
  finalMapping    Json?
  missingRequired Json?
  outcome         String // "auto" | "manual_fix" | "abandoned"
  createdAt       DateTime @default(now())

  @@index([surface, createdAt])
  @@map("upload_header_event")
}
