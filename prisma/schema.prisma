// Wave D — tie-in amortization schedule shape. `symmetrical` uses the
// engine's PMT formula so every period is the same; `custom` lets the
// user enter a different amortizationDue for each period, persisted as
// ContractAmortizationSchedule rows for the owning term.
enum AmortizationShape {
  symmetrical
  custom
}

enum InvoiceDisputeStatus {
  none
  disputed
  resolved
  rejected
}


// ─── Better Auth managed tables ───────────────────────────────────

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  role          UserRole @default(facility)
  lastLoginAt   DateTime?
  // Offboarding without destroying provenance. A user who has performed
  // audited actions must not be hard-deleted: audit_log.userId is RESTRICT,
  // so the delete throws, and losing the actor behind a financial/PHI audit
  // trail is the opposite of what this system is for. Deactivating blocks
  // sign-in and revokes live sessions while leaving history intact.
  deactivatedAt DateTime?
  // Surfaced via the @better-auth/stripe plugin. Lets the plugin
  // join the Stripe customer when reading user state (e.g. inside
  // findUserByEmail) so the experimental.joins fast path doesn't
  // throw "Unknown field stripeCustomerId" on every sign-in.
  stripeCustomerId String? @unique
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions Session[]
  accounts Account[]
  members  Member[]

  createdContracts Contract[] @relation("CreatedByUser")
  payments         Payment[]
  credits          Credit[]
  auditLogs        AuditLog[]
  renewalAlertSettings RenewalAlertSettings?
  renewalNotes     RenewalNote[]
  completedRenewalTasks RenewalTask[] @relation("RenewalTaskCompleter")
  rebateInsightFlags RebateInsightFlag[]
  notifications    Notification[]
  contractExtractionCache ContractExtractionCache[]
  divisionMembers      DivisionMember[]
  facilityAssignments  FacilityAssignment[]

  @@index([role])
  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verification")
}

// ─── Better Auth Organization plugin tables ───────────────────────

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  logo      String?
  metadata  String?
  createdAt DateTime @default(now())

  members     Member[]
  invitations Invitation[]

  facility Facility?
  vendor   Vendor?

  @@map("organization")
}

model Member {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  role           String   @default("member")
  // Settings/Users access tier — see enum AccessTier. Orthogonal to
  // `role` (org-plugin owner/admin/member). Defaults to `super` so
  // existing members keep full access until explicitly demoted.
  accessTier     AccessTier @default(super)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("member")
}

model Invitation {
  id             String   @id @default(cuid())
  organizationId String
  email          String
  role           String?
  status         String   @default("pending")
  expiresAt      DateTime
  inviterId      String

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("invitation")
}

// ─── Domain Models ────────────────────────────────────────────────

model HealthSystem {
  id                  String   @id @default(cuid())
  name                String
  code                String?  @unique
  headquarters        String?
  logoUrl             String?
  primaryContactEmail String?
  phone               String?
  website             String?
  createdAt           DateTime @default(now())

  facilities Facility[]

  @@map("health_system")
}

model Facility {
  id             String       @id @default(cuid())
  name           String
  type           FacilityType @default(hospital)
  address        String?
  city           String?
  state          String?
  zip            String?
  beds           Int?
  healthSystemId String?
  status         String       @default("active")
  organizationId String?      @unique
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  healthSystem HealthSystem? @relation(fields: [healthSystemId], references: [id])
  organization Organization? @relation(fields: [organizationId], references: [id])

  contracts          Contract[]
  pendingContracts   PendingContract[]
  cogRecords         COGRecord[]
  pricingFiles       PricingFile[]
  fileImports        FileImport[]
  purchaseOrders     PurchaseOrder[]
  invoices           Invoice[]
  alerts             Alert[]            @relation("FacilityAlerts")
  contractPeriods    ContractPeriod[]
  rebates            Rebate[]
  payments           Payment[]
  creditEntries      Credit[]
  cases              Case[]
  surgeonUsages      SurgeonUsage[]
  connections        Connection[]       @relation("FacilityConnections")
  featureFlags       FeatureFlag[]
  aiCredits          AICredit[]         @relation("FacilityAICredits")
  reportSchedules    ReportSchedule[]
  contractFacilities ContractFacility[]
  payorContracts     PayorContract[]
  rebateInsightCaches RebateInsightCache[]
  rebateInsightFlags  RebateInsightFlag[]
  crossVendorTieIns  CrossVendorTieIn[]
  vendorNameMappings VendorNameMapping[]
  facilityAssignments FacilityAssignment[]
  proposalEvaluations ProposalEvaluation[]

  @@index([status])
  @@map("facility")
}

/// A facility's saved evaluation of a vendor proposal (the "Evaluate Proposals"
/// flow). Replaces the prior localStorage-only store so evaluations survive
/// refresh / device and can be reopened + re-run. The rich engine payload
/// (input / result / clauseAnalysis — the `ScoredProposal` shape) lives in the
/// `payload` JSON column, mirroring how the vendor side stores proposal data in
/// `PendingContract.pricingData`. `overallScore` + `verdict` are denormalized
/// for the list/sort without parsing JSON per row.
model ProposalEvaluation {
  id             String   @id @default(cuid())
  facilityId     String
  vendorName     String
  /// "upload" | "manual"
  source         String   @default("manual")
  /// result.scores.overall (0–100, one decimal)
  overallScore   Float?
  /// result.recommendation.verdict — "accept" | "negotiate" | "decline"
  verdict        String?
  /// { input: AnalyzeProposalInput, result: AnalyzeProposalResult, clauseAnalysis }
  payload        Json
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  facility       Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  @@index([facilityId])
  @@map("proposal_evaluation")
}

model Vendor {
  id             String     @id @default(cuid())
  name           String
  code           String?
  displayName    String?
  division       String?
  parentVendorId String?
  logoUrl        String?
  contactName    String?
  contactEmail   String?
  contactPhone   String?
  website        String?
  address        String?
  city           String?
  state          String?
  zip            String?
  status         String     @default("active")
  tier           VendorTier @default(standard)
  // Vendor-level operating mode (Charles 2026-06-20). Lets a STANDALONE
  // vendor (no facility connections) explicitly choose 1-way (own contracts +
  // own COGs) vs 2-way (facility connection). Nullable: when null the mode is
  // derived from connections as before (byte-identical pre-feature behavior).
  defaultMode    ConnectionMode?
  organizationId String?    @unique
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  parentVendor Vendor?  @relation("VendorHierarchy", fields: [parentVendorId], references: [id])
  childVendors Vendor[] @relation("VendorHierarchy")
  organization Organization? @relation(fields: [organizationId], references: [id])

  contracts          Contract[]
  pendingContracts   PendingContract[]
  cogRecords         COGRecord[]
  pricingFiles       PricingFile[]
  fileImports        FileImport[]
  purchaseOrders     PurchaseOrder[]
  invoices           Invoice[]
  alerts             Alert[]            @relation("VendorAlerts")
  vendorNameMappings VendorNameMapping[]
  connections        Connection[]       @relation("VendorConnections")
  aiCredits          AICredit[]         @relation("VendorAICredits")
  divisions          VendorDivision[]
  productBenchmarks  ProductBenchmark[]
  crossVendorTieInMembers CrossVendorTieInMember[]
  vendorCogRecords   VendorCogRecord[]
  aliases            VendorAlias[]

  @@map("vendor")
}

// ─── Cross-Vendor Tie-In (v0 doc §4 — facility GPO bundle) ─────────
//
// A facility-level bundle that spans multiple vendors. Each member
// vendor commits to a minimum spend in exchange for an extra rebate
// percentage; if every member hits its minimum the facility unlocks
// an additional bonus on the bundle's total spend. Math lives in
// `lib/v0-spec/tie-in.ts::v0CrossVendorTieIn` — this model is just
// persistence.

model CrossVendorTieIn {
  id                       String   @id @default(cuid())
  facilityId               String
  name                     String
  /** Integer percent (1.0 = 1%). Applied to total spend when bonus criterion is met. */
  facilityBonusRate        Decimal  @default(0) @db.Decimal(5, 2)
  /** "all_compliant" or "none". v0 supports more bands; tydei carries the two it actually uses. */
  facilityBonusRequirement String   @default("all_compliant")
  status                   String   @default("active") // active | paused | closed
  effectiveDate            DateTime
  expirationDate           DateTime
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  facility Facility                 @relation(fields: [facilityId], references: [id])
  members  CrossVendorTieInMember[]

  @@index([facilityId, status])
  @@map("cross_vendor_tie_in")
}

model CrossVendorTieInMember {
  id                  String  @id @default(cuid())
  crossVendorTieInId  String
  vendorId            String
  /** Annual minimum spend commitment for this vendor in the bundle. */
  minimumSpend        Decimal @db.Decimal(14, 2)
  /** Integer percent (2.5 = 2.5%) — vendor's contribution rate when compliant. */
  rebateContribution  Decimal @db.Decimal(5, 2)
  createdAt           DateTime @default(now())

  crossVendorTieIn CrossVendorTieIn @relation(fields: [crossVendorTieInId], references: [id], onDelete: Cascade)
  vendor           Vendor           @relation(fields: [vendorId], references: [id])

  @@index([crossVendorTieInId])
  @@index([vendorId])
  @@map("cross_vendor_tie_in_member")
}

model VendorDivision {
  id         String   @id @default(cuid())
  vendorId   String
  name       String
  code       String
  categories String[] @default([])
  // The catch-all "All Products" division created by the backfill so
  // existing un-divisioned rows have a home. A vendor has at most one.
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())

  vendor           Vendor            @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  members          DivisionMember[]
  contracts        Contract[]        @relation("ContractDivision")
  vendorCogRecords VendorCogRecord[]
  connections      Connection[]
  pendingContracts PendingContract[]

  @@unique([vendorId, code])
  @@index([vendorId])
  @@map("vendor_division")
}

// User ↔ vendor-division attachment (Settings/Users feature). A user
// may belong to many divisions within one vendor org; visibility is
// hard-scoped to the divisions they are attached to. Kept separate from
// the better-auth Member table (which is one row per user↔organization).
model DivisionMember {
  id         String   @id @default(cuid())
  divisionId String
  userId     String
  createdAt  DateTime @default(now())

  division VendorDivision @relation(fields: [divisionId], references: [id], onDelete: Cascade)
  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([divisionId, userId])
  @@index([userId])
  @@index([divisionId])
  @@map("division_member")
}

// User ↔ facility assignment (facility enterprise scoping). A scoped
// facility user sees only the facilities assigned here; an enterprise
// user (by access tier / membership) sees every facility in their
// HealthSystem and needs no rows.
model FacilityAssignment {
  id         String   @id @default(cuid())
  userId     String
  facilityId String
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  facility Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  @@unique([userId, facilityId])
  @@index([userId])
  @@index([facilityId])
  @@map("facility_assignment")
}

model ProductCategory {
  id          String   @id @default(cuid())
  name        String
  description String?
  parentId    String?
  source      String?  // 'manual' | 'contract' | 'pricing_file' | 'cog'
  sourceId    String?  // FK back to the originating entity
  spendTotal  Decimal  @default(0) @db.Decimal(14, 2)
  itemCount   Int      @default(0)
  createdAt   DateTime @default(now())

  parent   ProductCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children ProductCategory[] @relation("CategoryHierarchy")

  contracts          Contract[]
  contractCategories ContractProductCategory[]

  @@map("product_category")
}

// ─── Contract Models ──────────────────────────────────────────────

model Contract {
  id                     String            @id @default(cuid())
  contractNumber         String?
  name                   String
  vendorId               String
  facilityId             String?
  productCategoryId      String?
  contractType           ContractType      @default(usage)
  status                 ContractStatus    @default(draft)
  effectiveDate          DateTime          @db.Date
  expirationDate         DateTime          @db.Date
  autoRenewal            Boolean           @default(false)
  terminationNoticeDays  Int               @default(90)
  totalValue             Decimal           @default(0) @db.Decimal(14, 2)
  annualValue            Decimal           @default(0) @db.Decimal(14, 2)
  description            String?
  notes                  String?
  gpoAffiliation         String?
  performancePeriod      PerformancePeriod @default(monthly)
  rebatePayPeriod        PerformancePeriod @default(quarterly)
  isGrouped              Boolean           @default(false)
  // Vendor IDs participating in a grouped (multi-vendor) contract
  // *in addition to* the primary `vendorId`. The matcher in
  // lib/cog/recompute.ts registers the contract under each of these
  // vendor IDs so COG rows for additional vendors resolve to the
  // grouped contract via the cascade's vendorId+date path, and
  // pricing-file REFs from any included vendor count as on-contract.
  additionalVendorIds    String[]          @default([])
  isMultiFacility        Boolean           @default(false)
  tieInCapitalContractId String?
  // Charles audit deferred-fix: vendor's organizational division
  // (e.g. "Surgical", "Cardiology"). Persists from PendingContract
  // on approve so contracts list / search can group by it. Pre-fix
  // the approve path tried to write this column but it didn't
  // exist on Contract, which silently dropped the value.
  division               String?
  // Settings/Users feature: FK to the vendor's division for hard data
  // isolation ("each division behaves like a separate company"). Nullable
  // — facility-only and grouped multi-vendor contracts have no single
  // vendor division. Distinct from the free-string `division` above
  // (which is a display label persisted from PendingContract).
  vendorDivisionId       String?
  // Charles audit suggestion #4 (v0-port): legacy single-item capital
  // fields removed. Capital lives in ContractCapitalLineItem rows
  // (1:N), which support multi-asset financing per v0's
  // LeasedServiceItem[] shape. amortizationShape is the only
  // contract-level capital field that survives — it gates the
  // schedule-source choice (custom rows vs computed PMT) for ALL
  // line items uniformly.
  amortizationShape      AmortizationShape @default(symmetrical)
  complianceRate         Decimal?          @db.Decimal(5, 2)
  currentMarketShare     Decimal?          @db.Decimal(5, 2)
  marketShareCommitment  Decimal?          @db.Decimal(5, 2)
  /**
   * Charles 2026-04-25 (audit follow-up): per-category market share
   * commitments. Vendor commitments are usually expressed per
   * category ("60% of Joint Replacement, 40% of Spine"), not as a
   * single contract-wide number. This Json blob keeps the schema
   * change minimal — `[{ category, commitmentPct }, ...]`.
   * `getCategoryMarketShareForVendor` already returns the LIVE share;
   * this stores the COMMITMENT side so the threshold engine can
   * evaluate met-vs-target per category. Null = no per-category
   * targets set; the engine falls back to `marketShareCommitment`
   * (contract-wide).
   */
  marketShareCommitmentByCategory Json?
  createdById            String?
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  vendor          Vendor           @relation(fields: [vendorId], references: [id])
  facility        Facility?        @relation(fields: [facilityId], references: [id])
  productCategory ProductCategory? @relation(fields: [productCategoryId], references: [id])
  createdBy       User?            @relation("CreatedByUser", fields: [createdById], references: [id])
  vendorDivision  VendorDivision?  @relation("ContractDivision", fields: [vendorDivisionId], references: [id])

  terms              ContractTerm[]
  pricingItems       ContractPricing[]
  documents          ContractDocument[]
  periods            ContractPeriod[]
  amortizationRows   ContractAmortizationSchedule[]
  capitalLineItems   ContractCapitalLineItem[]
  renewalNotes       RenewalNote[]
  renewalTasks       RenewalTask[]
  rebates            Rebate[]
  payments           Payment[]
  creditEntries      Credit[]
  alerts             Alert[]
  purchaseOrders     PurchaseOrder[]
  surgeonUsages      SurgeonUsage[]
  contractFacilities   ContractFacility[]
  contractCategories   ContractProductCategory[]
  changeProposals      ContractChangeProposal[]
  tieInBundlePrimary   TieInBundle?        @relation("PrimaryContract")
  tieInBundleMembers   TieInBundleMember[]
  priceVariances       InvoicePriceVariance[]
  accruals             RebateAccrual[]
  renewalBriefCaches   RenewalBriefCache[]
  tieInShortfallLedger ContractTieInShortfallLedger[]
  // 2026-06-09: back-relation for PendingContract.approvedContractId.
  approvedFromPending  PendingContract[]              @relation("ApprovedFromPending")

  @@index([vendorId])
  @@index([facilityId])
  @@index([status])
  @@index([expirationDate])
