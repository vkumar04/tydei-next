/**
 * Charles audit suggestion #4 (v0-port): per-asset capital line items.
 * One Contract can finance multiple pieces of equipment (e.g. an MRI
 * + service warranty in one master deal). The legacy single-item shape
 * lives on Contract.capitalCost/etc; line items here override when
 * present and aggregate to the same schedule downstream.
 */
model ContractCapitalLineItem {
