model ContractTerm {
  id                   String       @id @default(cuid())
  contractId           String
  termName             String
  termType             TermType     @default(spend_rebate)
  baselineType         BaselineType @default(spend_based)
  evaluationPeriod     String       @default("annual")
  paymentTiming        String       @default("quarterly")
  appliesTo            String       @default("all_products")
  rebateMethod         RebateMethod @default(cumulative)
  effectiveStart       DateTime     @db.Date
  effectiveEnd         DateTime     @db.Date
  volumeType           VolumeType?
  spendBaseline        Decimal?     @db.Decimal(14, 2)
  volumeBaseline       Int?
  growthBaselinePercent Decimal?    @db.Decimal(5, 2)
  desiredMarketShare   Decimal?     @db.Decimal(5, 2)
  // Unified rebate engine additions (all nullable / defaulted) —
  // used by engine config builders to express the full 8-type matrix.
  boundaryRule             TierBoundaryRule?
  priceReductionTrigger    PriceReductionTrigger?
  // Wave C — tie-in shortfall handling policy. Existing enum is reused
  // (TrueUpShortfallHandling has the same two values). Default carry_forward
  // so tie-in terms that omit the field behave per the safer policy; non-
  // tie-in terms are unaffected since the column is ignored by their engines.
  shortfallHandling        TrueUpShortfallHandling? @default(carry_forward)
  negotiatedBaseline       Decimal?        @db.Decimal(14, 2)
  growthOnly               Boolean         @default(false)
  periodCap                Decimal?        @db.Decimal(14, 2)
  fixedRebatePerOccurrence Decimal?        @db.Decimal(12, 2)
  // Charles W1.T — Wave B tie-in capital fields moved to Contract. A
  // contract-level `minimumPurchaseCommitment` stays on the term because
  // per-term consumable spend commitments are a real concept (e.g., a
  // "Qualified Annual Spend Rebate" term has its own minimum purchase
  // separate from the capital balance).
  minimumPurchaseCommitment Decimal?       @db.Decimal(14, 2)
  // Roadmap track 4 (2026-04-20): GPO admin fee taken off the top of
  // rebate earnings. Stored as a fraction (0.03 = 3%). Null = no admin
  // fee on this term. Drives `computeNetRebate(gross, adminFee)` which
  // every rebate-display surface routes through so "net rebate" is
  // consistent with "gross rebate − admin fee". See
  // `lib/contracts/admin-fee.ts`.
  adminFeePercent          Decimal?        @db.Decimal(5, 4)
  cptCodes                 String[]        @default([])
  groupedReferenceNumbers  String[]        @default([])
  referenceNumbers         String[]        @default([])
  categories               String[]        @default([])
  marketShareVendorId      String?
  marketShareCategory      String?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  contract          Contract                      @relation(fields: [contractId], references: [id], onDelete: Cascade)
  tiers             ContractTier[]
  products          ContractTermProduct[]
  procedures        ContractTermProcedure[]

  @@index([contractId])
  @@map("contract_term")
}

