// ─── Connections ──────────────────────────────────────────────────

model Connection {
  id             String               @id @default(cuid())
  facilityId     String
  facilityName   String
  vendorId       String
  vendorName     String
  status         ConnectionStatus     @default(pending)
  inviteType     ConnectionInviteType
  invitedBy      String
  invitedByEmail String
  invitedAt      DateTime             @default(now())
  respondedAt    DateTime?
  respondedBy    String?
  expiresAt      DateTime
  message        String?
  // Settings/Users feature: vendor sets the interaction mode per facility
  // connection. FAIL-SECURE default (2026-07-06 launch hardening): a new
  // connection is one_way — the facility's actuals do NOT flow to the vendor
  // until someone explicitly opts into two_way (via setConnectionMode). Was
  // two_way, which auto-shared facility purchasing actuals the moment a
  // connection was accepted. Existing rows are unaffected (a @default only
  // applies at INSERT); no connections are seeded, so nothing to backfill.
  mode           ConnectionMode @default(one_way)
  /// May this vendor publish a contract straight into this facility's tenant —
  /// live, with no per-contract review?
  ///
  /// Granted by the FACILITY, never the vendor: it is the facility that carries
  /// the risk (a live Contract row on its tenant, and a COG match-status
  /// recompute against its records), so the facility owns the switch and can
  /// revoke it. `mode` deliberately does NOT gate this — that axis is about the
  /// facility's data flowing outward, and reusing it here meant every newly
  /// accepted connection auto-granted publish rights via its fail-secure
  /// default. Accepting an invite means "let's do business", not "auto-approve
  /// everything you send me from now on". Charles 2026-07-28.
  autoActivateContracts Boolean @default(false)
  // Optional division scope for the connection (vendor-wide when null).
  vendorDivisionId String?

  facility       Facility        @relation("FacilityConnections", fields: [facilityId], references: [id])
  vendor         Vendor          @relation("VendorConnections", fields: [vendorId], references: [id])
  vendorDivision VendorDivision? @relation(fields: [vendorDivisionId], references: [id])

  @@index([facilityId])
  @@index([vendorId])
  @@index([status])
  @@index([vendorDivisionId])
  @@map("connection")
}

