DATABASE_URL=postgresql://tydei:tydei_dev_password@localhost:5432/tydei
BETTER_AUTH_SECRET=change-me-in-production
# Prod: https://tydei.com (also the code fallback in lib/site-url.ts)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
STRIPE_ENTERPRISE_PRICE_ID=
RESEND_API_KEY=
# Anthropic key — required for every AI surface (extract, chat, analysis).
ANTHROPIC_API_KEY=
# Bearer secret for the alert-synthesis cron route (unset → route 404s).
CRON_SECRET=
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
BETTER_AUTH_URL=

# Show demo quick-login buttons on the sign-in page (server-evaluated gate).
# Set to "true" in non-prod to render them; unset/false hides them and ships
# NO demo credentials to the client. Set false + remove demo users near launch.
SHOW_DEMO_LOGINS=true
