{
  "name": "tydei-next",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "bun scripts/clear-stale-dev-cache.ts && next dev --turbopack",
    "build": "prisma generate && next build && bash scripts/standalone-postbuild.sh",
    "build:analyze": "ANALYZE=true bun run build",
    "start": "HOSTNAME=0.0.0.0 bun .next/standalone/server.js",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "lint:ci": "oxlint . --deny-warnings",
    "db:push": "prisma db push --config prisma/prisma.config.ts",
    "db:migrate": "prisma migrate dev --config prisma/prisma.config.ts",
    "db:seed": "bun run prisma/seed.ts && bun run scripts/qa-sanity.ts",
    "db:studio": "prisma studio --config prisma/prisma.config.ts",
    "qa:sanity": "bun run scripts/qa-sanity.ts",
    "qa:seed": "bun run scripts/qa-sanity.ts",
    "qa:golden": "bun run scripts/qa-golden-calculations.ts",
    "qa:dom-diff": "bun run scripts/dual-app-dom-diff.ts",
    "smoke": "bun run scripts/pre-ship-smoke.ts",
    "lint:ai": "bun run scripts/lint-ai-action-error-paths.ts",
    "lint:ai-schema": "bun run scripts/lint-ai-schema-describe.ts",
    "test:unit": "bunx vitest run --exclude '**/.claude/**' --exclude '**/.worktrees/**' --exclude '**/*.integration.test.ts'",
    "test:integration": "RUN_INTEGRATION=1 bunx vitest run integration.test --exclude '**/.claude/**' --exclude '**/.worktrees/**'",
    "test:e2e": "bunx playwright test --project=e2e-setup --project=e2e",
    "test:visual": "bunx playwright test --project=visual-setup --project=visual",
    "test:all": "bun run test:unit && bun run test:integration && bun run test:e2e",
    "email:dev": "email dev --dir emails --port 3001",
    "email:test": "bun run scripts/send-test-emails.ts",
    "postinstall": "node scripts/fix-tsc-bin.mjs"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.82",
    "@ai-sdk/react": "^4.0.147",
    "@aws-sdk/client-s3": "^3.1152.0",
    "@aws-sdk/s3-request-presigner": "^3.1152.0",
    "@better-auth/stripe": "^1.7.10",
    "@hookform/resolvers": "^5.9.2",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.1.1",
    "@tanstack/react-query": "^5.104.3",
    "@tanstack/react-table": "^9.3.1",
    "ai": "^7.0.143",
    "better-auth": "^1.7.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "decimal.js": "^10.6.0",
    "dotenv": "^18.0.8",
    "exceljs": "^4.4.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.9",
    "lucide-react": "^1.59.0",
    "motion": "^14.3.0",
    "mupdf": "^1.28.1",
    "next": "^16.4.2",
    "next-themes": "^0.4.6",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "pg": "^8.23.1",
    "prisma": "^7.10.1",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.90.0",
    "recharts": "^3.10.1",
    "resend": "^6.34.1",
    "sonner": "^2.0.8",
    "stripe": "^22.6.2",
    "tailwind-merge": "^3.7.0",
    "tesseract.js": "^7.0.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.4.2",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testcontainers/postgresql": "^12.2.1",
    "@types/node": "^26.6.5",
    "@types/pg": "8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/typescript6": "^6.0.2",
    "oxlint": "^1.88.0",
    "postcss": "^8.5.30",
    "railway": "^3.16.0",
    "react-email": "^6.11.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "pg": "^8.23.1",
    "@types/pg": "8.23.1",
    "tmp": "^0.2.7",
    "uuid": "^14.0.2",
    "deepmerge-ts": "^8.0.2",
    "mysql2": "^3.24.4"
  }
}
