{
  "name": "tydei-next",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "prisma generate && next build && bash scripts/standalone-postbuild.sh",
    "build:analyze": "ANALYZE=true bun run build",
    "start": "HOSTNAME=0.0.0.0 bun .next/standalone/server.js",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "lint:ci": "oxlint . --deny-warnings",
    "db:push": "prisma db push --config prisma/prisma.config.ts",
    "db:migrate": "prisma migrate dev --config prisma/prisma.config.ts",
    "db:seed": "bun run prisma/seed.ts && bun run scripts/qa-sanity.ts",
    "db:studio": "prisma studio --config prisma/prisma.config.ts",
    "qa:sanity": "bun run scripts/qa-sanity.ts",
    "qa:seed": "bun run scripts/qa-sanity.ts",
    "qa:dom-diff": "bun run scripts/dual-app-dom-diff.ts",
    "qa:v0-ledger": "bun run scripts/build-v0-feature-ledger.ts",
    "qa:v0-ledger-check": "bun run scripts/build-v0-feature-ledger.ts --check",
    "smoke": "bun run scripts/pre-ship-smoke.ts",
    "lint:ai": "bun run scripts/lint-ai-action-error-paths.ts",
    "lint:ai-schema": "bun run scripts/lint-ai-schema-describe.ts",
    "test:unit": "bunx vitest run --exclude '**/.claude/**' --exclude '**/.worktrees/**' --exclude '**/*.integration.test.ts'",
    "test:integration": "RUN_INTEGRATION=1 bunx vitest run integration.test --exclude '**/.claude/**' --exclude '**/.worktrees/**'",
    "test:e2e": "bunx playwright test --project=e2e-setup --project=e2e",
    "test:visual": "bunx playwright test --project=visual-setup --project=visual",
    "test:all": "bun run test:unit && bun run test:integration && bun run test:e2e"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.8",
    "@ai-sdk/react": "^4.0.16",
    "@aws-sdk/client-s3": "^3.1079.0",
    "@aws-sdk/s3-request-presigner": "^3.1079.0",
    "@better-auth/stripe": "^1.6.23",
    "@hookform/resolvers": "^5.4.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-table": "^8.21.3",
    "ai": "^7.0.15",
    "better-auth": "^1.6.23",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "embla-carousel-react": "^8.6.0",
    "exceljs": "^4.4.0",
    "input-otp": "^1.4.2",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^1.23.0",
    "motion": "^12.42.2",
    "mupdf": "^1.28.0",
    "next": "^16.2.10",
    "next-themes": "^0.4.6",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "pg": "^8.22.0",
    "prisma": "^7.8.0",
    "radix-ui": "^1.6.1",
    "react": "^19.2.7",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.81.0",
    "react-resizable-panels": "^4.12.1",
    "recharts": "^3.9.2",
    "resend": "^6.17.1",
    "sonner": "^2.0.7",
    "stripe": "^22.3.0",
    "tailwind-merge": "^3.6.0",
    "tesseract.js": "^7.0.0",
    "vaul": "^1.1.2",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.2.10",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.3.2",
    "@testcontainers/postgresql": "^12.0.4",
    "@types/node": "^26.1.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "oxlint": "^1.72.0",
    "postcss": "^8.5.16",
    "tailwindcss": "^4.3.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9",
    "zod-prisma-types": "^3.3.11"
  },
  "overrides": {
    "pg": "^8.22.0"
  }
}
